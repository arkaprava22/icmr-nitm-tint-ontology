{
  "name": "tint-ayush-knowledge-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "pilot:build": "node scripts/build-pilot-dataset.mjs",
    "ontology:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-fuseki.ps1",
    "ontology:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-fuseki.ps1",
    "ontology:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-fuseki.ps1",
    "ontology:start:docker": "docker compose up -d --build fuseki",
    "ontology:load": "node scripts/ontology-store.mjs load",
    "ontology:verify": "node scripts/ontology-store.mjs verify",
    "ontology:health": "node scripts/ontology-store.mjs health",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.3",
    "pg": "^8.13.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.3",
    "prisma": "7.10.0",
    "typescript": "^5.7.0"
  }
}
